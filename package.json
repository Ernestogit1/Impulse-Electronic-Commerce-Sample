{
  "name": "impulse-storefront",
  "private": true,
  "version": "1.0.0",
  "description": "Impulse Storefront — premium full-stack e-commerce platform by Impulse Software Solutions",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -n CLIENT,SERVER -c magenta,yellow \"npm:dev:client\" \"npm:dev:server\"",
    "dev:client": "npm run dev --workspace client",
    "dev:server": "npm run dev --workspace server",
    "build": "npm run build --workspace client",
    "start": "npm run start --workspace server",
    "seed": "npm run seed --workspace server",
    "lint": "npm run lint --workspace client",
    "typecheck": "npm run typecheck --workspace client && npm run typecheck --workspace server"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
